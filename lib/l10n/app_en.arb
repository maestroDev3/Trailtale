{
  "@@locale": "en",
  "appTitle": "Trailtale",
  "@appTitle": {
    "description": "Name of the app, shown in the app bar and as the window title."
  },
  "emptyTripsMessage": "No trips yet",
  "@emptyTripsMessage": {
    "description": "Shown on the home screen while the user has not created any trip."
  },
  "newTrip": "New trip",
  "@newTrip": {
    "description": "Label of the button that starts creating a new trip."
  },
  "tripDateRange": "{start} – {end}",
  "@tripDateRange": {
    "description": "Date range of a trip spanning several days.",
    "placeholders": {
      "start": {
        "type": "DateTime",
        "format": "yMMMd"
      },
      "end": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "tripSingleDate": "{date}",
  "@tripSingleDate": {
    "description": "Date of a trip that lasts one day.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd"
      }
    }
  },
  "tripDayCount": "{count, plural, =1{1 day} other{{count} days}}",
  "@tripDayCount": {
    "description": "Number of days a trip lasts.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "tripsLoadError": "Your trips could not be loaded.",
  "@tripsLoadError": {
    "description": "Shown on the home screen when stored trips cannot be read."
  },
  "editTrip": "Edit trip",
  "@editTrip": {
    "description": "Title of the form for changing an existing trip."
  },
  "tripTitleLabel": "Title",
  "@tripTitleLabel": {
    "description": "Label of the text field for the trip title."
  },
  "tripTitleRequired": "Please enter a title",
  "@tripTitleRequired": {
    "description": "Validation message when the trip title is empty."
  },
  "tripDatesLabel": "Dates",
  "@tripDatesLabel": {
    "description": "Label of the field showing and changing the trip dates."
  },
  "save": "Save",
  "@save": {
    "description": "Label of the button that saves a form."
  },
  "deleteTrip": "Delete trip",
  "@deleteTrip": {
    "description": "Tooltip of the action that deletes a trip."
  },
  "deleteTripQuestion": "Delete “{title}”?",
  "@deleteTripQuestion": {
    "description": "Title of the dialog confirming that a trip is deleted.",
    "placeholders": {
      "title": {
        "type": "String"
      }
    }
  },
  "deleteTripWarning": "The trip and everything in it will be removed from this device.",
  "@deleteTripWarning": {
    "description": "Explains the consequence of deleting a trip."
  },
  "cancel": "Cancel",
  "@cancel": {
    "description": "Label of a button that dismisses a dialog without changes."
  },
  "delete": "Delete",
  "@delete": {
    "description": "Label of a button that confirms deleting."
  },
  "noEntriesYet": "No entries yet",
  "@noEntriesYet": {
    "description": "Shown on a trip while it has no entries."
  },
  "newEntry": "New entry",
  "@newEntry": {
    "description": "Label of the button that starts creating a new entry in a trip."
  }
}
